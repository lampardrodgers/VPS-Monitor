# 复制到源码目录外的 ~/.config/vpsmonitor/web/.env.local 后填写。
# 只读 API 地址。默认指向本机 SSH 隧道映射出来的端口：
#   ssh -N -L 8787:127.0.0.1:18787 root@<SERVER_IP>
VITE_API_BASE_URL=http://127.0.0.1:8787

# 可选：让 npm run dev / npm run preview 自动管理 SSH 隧道。
# 自动模式使用 SSH Key（BatchMode），不会在后台等待密码输入。
VPSMON_AUTO_SSH_TUNNEL=0
VPSMON_SSH_TARGET=user@<SERVER_IP>
VPSMON_SSH_LOCAL_PORT=8787
VPSMON_SSH_REMOTE_HOST=127.0.0.1
VPSMON_SSH_REMOTE_PORT=18787
# VPSMON_SSH_IDENTITY_FILE=/path/to/private/key

# 可选：开发期使用内置假数据，不连真实 API。
# 只在 npm run dev 下生效，生产构建会忽略并移除相关代码。
# VITE_USE_MOCK=1
