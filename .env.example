# 仅列出变量名。真实值由 scripts/configure.sh 写入源码目录外的
# ~/.config/vpsmonitor/secrets.env，或通过进程环境提供。
VPSMON_BANDWAGON_API_KEY_1=
VPSMON_ALIYUN_ACCESS_KEY_ID=
VPSMON_ALIYUN_ACCESS_KEY_SECRET=
VPSMON_PANSTAR_TOKEN=
VPSMON_GREENCLOUD_TOKEN=
VPSMON_DEDIONE_API_KEY=
VPSMON_DEDIONE_API_PASS=

# API 默认仅允许回环监听。不要在公开仓库中填写真实主机或凭据。
VPSMON_API_HOST=127.0.0.1
VPSMON_API_PORT=8787
VPSMON_LIVE_MIN_INTERVAL_SECONDS=30
