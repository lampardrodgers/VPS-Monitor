# 复制到源码目录外的 ~/.config/vpsmonitor/web/.env.local 后填写。
# 按需模式使用 Vite 的同源代理；浏览器不会直接接触 SSH 端口。
VITE_API_BASE_URL=/__vpsmonitor_api

# 每轮 API 请求时临时建立 SSH，并发请求共用；本轮结束后立即关闭。
# 使用 SSH Key（BatchMode），不会在后台等待密码输入。
VPSMON_SSH_ON_DEMAND=1
VPSMON_SSH_TARGET=user@<SERVER_IP>
# 0 表示每轮自动分配空闲端口，避免与已有隧道冲突。
VPSMON_SSH_LOCAL_PORT=0
VPSMON_SSH_REMOTE_HOST=127.0.0.1
VPSMON_SSH_REMOTE_PORT=18787
# VPSMON_SSH_IDENTITY_FILE=/path/to/private/key
# VPSMON_SSH_IDLE_MS=500

# 可选：开发期使用内置假数据，不连真实 API。
# 只在 npm run dev 下生效，生产构建会忽略并移除相关代码。
# VITE_USE_MOCK=1
